# Codebase Knowledge Graph Environment Configuration

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=codebase_kg_secret_password
NEO4J_DATABASE=neo4j

# GraphQL API Gateway
PORT=4000
GRAPHQL_PATH=/graphql
CORS_ORIGIN=http://localhost:3000

# AI Provider (Optional: falls back to intelligent built-in semantic planner if no key provided)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022

# Frontend Next.js Web
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql
